# ===========================================
# AI Appointment Setter - Client Configuration
# ===========================================

# YOUR API KEY (same for all clients)
ANTHROPIC_API_KEY=your-anthropic-api-key

# YOUR EMAIL SETUP (same for all clients)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password

# ===========================================
# CLIENT-SPECIFIC (change for each client)
# ===========================================

# Client's business info
BUSINESS_NAME=Coach Mike Fitness
ASSISTANT_NAME=Alex

# Where to send lead notifications
COACH_EMAIL=coach@email.com

# Client's Calendly API key (they generate this)
# Get it from: calendly.com/integrations/api_webhooks
CALENDLY_API_KEY=eyJ...their-api-key

# OPTIONAL - Bot auto-detects these from API key!
# Only set if client has multiple event types and wants a specific one
# CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/xxx
# CALENDLY_SCHEDULING_URL=https://calendly.com/coach/30min

# Server config
PORT=3456
# BASE_URL=https://your-app.railway.app
